# Copy to .env in lunovest-api and replace placeholders. Never commit credentials.
PORT=8000
NODE_ENV=development

# This API's base URL, used by the cron service. Use the public URL in production.
APP_URL=https://lunovest-api.onrender.com

# Required Firebase Admin credentials from the service account JSON.
# Firebase Console > Project settings > Service accounts > Generate new private key.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
# Keep the key quoted on one line, with literal \n separators.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@lunovest-api.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=115588471238175513657

# Currently referenced only in commented-out CORS code:
# FRONTEND_URL=http://localhost:5173

